  <title>SqlMan · 互动入门</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23111c2d'/%3E%3Cpath d='M18 19h28M18 32h20M18 45h28' stroke='%233fe0c5' stroke-width='5' stroke-linecap='round'/%3E%3C/svg%3E">
  <style>
    :root{--ink:#0e1726;--muted:#607086;--paper:#f6f8fb;--card:#fff;--navy:#111c2d;--teal:#0fb99d;--mint:#3fe0c5;--orange:#ff9e52;--line:#dce4ed;--good:#14866d;--bad:#bd4357}
    *{box-sizing:border-box} body{margin:0;background:var(--paper);font:16px/1.6 ui-sans-serif,system-ui,"Microsoft YaHei",sans-serif;color:var(--ink)}
    button{font:inherit;cursor:pointer} .shell{max-width:1180px;margin:auto;padding:26px}
    header{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:28px}.brand{display:flex;align-items:center;gap:12px;font-weight:800;font-size:1.25rem}.mark{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:var(--navy);color:var(--mint);font-family:monospace}.tag{color:var(--muted);font-size:.9rem}.back{color:var(--muted);text-decoration:none;font-size:.9rem}
    .hero{background:var(--navy);color:white;border-radius:22px;padding:42px;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:360px;height:360px;border-radius:50%;right:-150px;top:-180px;background:radial-gradient(circle,var(--teal),transparent 68%);opacity:.6}.eyebrow{color:var(--mint);font:700 .8rem/1.2 monospace;letter-spacing:.08em}.hero h1{font-size:clamp(2rem,5vw,3.7rem);line-height:1.08;margin:11px 0 15px;max-width:720px}.hero p{max-width:650px;color:#c8d5e7;margin:0 0 25px}.hero button{background:var(--mint);border:0;border-radius:9px;padding:12px 18px;color:var(--navy);font-weight:800}
    .layout{display:grid;grid-template-columns:255px minmax(0,1fr);gap:26px;margin-top:28px}.rail{position:sticky;top:16px;height:max-content;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px}.rail small{display:block;color:var(--muted);padding:6px 10px}.lesson-nav{width:100%;border:0;background:transparent;text-align:left;padding:10px;border-radius:9px;color:#44546a}.lesson-nav span{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;font-size:.75rem;background:#edf1f5;margin-right:8px}.lesson-nav.active{background:#e7faf6;color:#087d69;font-weight:700}.lesson-nav.done span{background:var(--teal);color:white}.progress{height:5px;background:#e5ebf1;border-radius:6px;margin:10px}.progress i{display:block;height:100%;width:0;background:var(--teal);border-radius:inherit;transition:.3s}
    main{min-width:0}.lesson{display:none}.lesson.active{display:block;animation:in .28s ease}@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.kicker{font:700 .8rem monospace;color:var(--teal);letter-spacing:.07em}.lesson h2{font-size:2rem;line-height:1.2;margin:.3rem 0 .7rem}.lesson>p{color:var(--muted);max-width:720px}
    .stage{margin-top:22px;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}.stage-head{padding:11px 16px;border-bottom:1px solid var(--line);font-size:.88rem;font-weight:700;display:flex;justify-content:space-between}.code{padding:20px;background:#101b2c;color:#d9e5f6;font:14px/1.75 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow:auto}.kw{color:#81b7ff}.type{color:#71e0cc}.str{color:#ffbb78}.comment{color:#7890ad}.hl{background:rgba(63,224,197,.14);outline:1px solid rgba(63,224,197,.35);border-radius:3px}
    .controls{padding:17px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.primary{border:0;border-radius:8px;background:var(--teal);color:white;padding:10px 15px;font-weight:700}.secondary{border:1px solid var(--line);border-radius:8px;background:white;padding:9px 14px;color:#30435d}.result{padding:0 17px 17px;color:var(--muted)}.result.ok{color:var(--good);font-weight:700}.result.bad{color:var(--bad);font-weight:700}
    .choices{display:grid;gap:10px;padding:18px}.choice{border:1px solid var(--line);background:white;border-radius:10px;padding:12px;text-align:left}.choice:hover{border-color:var(--teal)}.choice.correct{border-color:var(--good);background:#effbf7}.choice.wrong{border-color:var(--bad);background:#fff3f5}.tip{margin:18px 0;padding:14px 16px;border-left:4px solid var(--orange);background:#fff8ef;color:#71451e;border-radius:0 10px 10px 0}.pager{display:flex;justify-content:space-between;margin-top:25px}.pager button{border:1px solid var(--line);background:white;border-radius:9px;padding:10px 15px}.pager button:disabled{opacity:.35;cursor:not-allowed}
    .binding{padding:20px;display:grid;gap:12px}.slot-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-family:ui-monospace,monospace}.slot{padding:4px 9px;border-radius:5px;background:#e9eff5}.pill{background:#dff8f3;color:#087d69;padding:4px 9px;border-radius:20px;font-weight:700}.table{margin:20px;border-collapse:collapse;width:calc(100% - 40px);font-size:.9rem}.table th,.table td{border-bottom:1px solid var(--line);padding:9px;text-align:left}.table th{color:var(--muted);font-weight:600}.final{padding:25px;text-align:center}.final .badge{display:inline-block;background:#e6faf5;color:#087d69;border-radius:999px;padding:5px 12px;font-weight:700}
    @media(max-width:800px){.shell{padding:16px}.hero{padding:28px}.layout{grid-template-columns:1fr}.rail{position:static;display:flex;overflow:auto;padding:8px}.rail small,.progress{display:none}.lesson-nav{white-space:nowrap;min-width:max-content}.lesson-nav span{display:none}.lesson h2{font-size:1.65rem}}
